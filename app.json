{
  "expo": {
    "name": "Doughfolio",
    "slug": "doughfolio",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFD8DF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ru.wladradchenko.doughfolio",
      "targetSdkVersion": 35,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "statusBar": {
        "translucent": true
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e823962c-16e5-4582-8610-2b2a3bb14aa2"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#FF6E76"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Doughfolio uses your location to show collectible coins on the radar near you. Foreground only — never in the background."
        }
      ]
    ],
    "sdkVersion": "54.0.0",
    "platforms": ["android"]
  }
}
